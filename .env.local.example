# Copy to .env.local (not committed): what differs on the machine where you run `npm run dev`.
# It wins over .env for the server. `npm run setup` writes it for you.

# Serial port of the Zigbee coordinator (ZNP dongle).  Windows: COM4  |  Linux: /dev/ttyUSB0
Z_DONGLE_PATH=COM4

# The data (databases, log, Zigbee network key) is in server/persistence by default. Optional:
# DATA_DIR=./persistence
# DB_PATH=./persistence/app.db
