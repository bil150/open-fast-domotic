meta {
  name: Update Sequence
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/sequences/:sequence_id
  body: json
  auth: none
}

params:path {
  sequence_id: {{sequenceId}}
}

body:json {
  {
    "name": "Day",
    "steps": [
      {
        "scene_id": {{sceneId}},
        "duration": 3600,
        "fade": true
      }
    ],
    "loop": true,
    "enabled": true
  }
}
