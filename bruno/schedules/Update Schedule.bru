meta {
  name: Update Schedule
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/schedules/:schedule_id
  body: json
  auth: none
}

params:path {
  schedule_id: {{scheduleId}}
}

body:json {
  {
    "name": "Evening light",
    "cron": "30 18 * * *",
    "scene_id": {{sceneId}},
    "enabled": true
  }
}
