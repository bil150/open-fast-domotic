# Copy to .env at the root of the project (next to docker-compose.yml). docker compose loads it as is into the
# server; the client (Vite) and the server in dev read it too.
# To run the server on your machine (npm run dev), put your own values in .env.local: see .env.local.example.

# Your timezone: schedules run in it
TZ=UTC

# Host device of the Zigbee dongle: ls /dev/ttyUSB* /dev/ttyACM*  (inside the container it is /dev/ttyUSB0)
Z_DONGLE_DEVICE=/dev/ttyUSB0

# The server. No Z_DONGLE_PATH here: in the container the dongle is always /dev/ttyUSB0 (the default), and
# a port set here would also reach the server run from VS Code (it loads this file) and override .env.local.
Z_DONGLE_BAUDRATE=115200
PYTHONUNBUFFERED=1

# Where the server keeps its data (databases, log, Zigbee network key): in the container it is /data, the
# volume, by itself. Only set DATA_DIR / DB_PATH to use another place.

# Optional
# CORS_ORIGINS=*                # comma separated list of allowed web origins
# RESTORE_ANIMATIONS=true       # resume the light animations after a restart
