# Copy to .env at the root of the project (next to docker-compose.yml): the only env file. docker compose loads
# it as is into the server, and the server and the client (Vite) read it too in dev. `npm run setup` writes it.

# Your timezone: schedules run in it
TZ=UTC

# Host device of the radio dongle, for Docker: ls /dev/ttyUSB* /dev/ttyACM*  (inside the container it is
# always /dev/ttyUSB0)
Z_DONGLE_DEVICE=/dev/ttyUSB0

# Serial port of the dongle for the server run on your machine (npm run dev).  Windows: COM4  |  Linux: /dev/ttyUSB0
# Docker ignores it: docker-compose.yml fixes it to /dev/ttyUSB0 in the container.
Z_DONGLE_PATH=/dev/ttyUSB0
Z_DONGLE_BAUDRATE=115200
PYTHONUNBUFFERED=1

# Where the server keeps its data (databases, log, radio network key): in the container it is /data, the
# volume, by itself; on your machine, server/persistence. Only set DATA_DIR / DB_PATH to use another place.

# Optional
# CORS_ORIGINS=*                # comma separated list of allowed web origins
# RESTORE_ANIMATIONS=true       # resume the light animations after a restart
